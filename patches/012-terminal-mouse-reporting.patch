         guac_terminal_notify(term);
     }
 
+    /* The application asked for the mouse (xterm DECSET 1000/1002/1003):
+     * report to it rather than select or scroll here. Shift keeps the local
+     * behaviour, as in xterm, so text can still be selected and copied. */
+    if ((term->mouse_report_x11 || term->mouse_report_button || term->mouse_report_any)
+            && !term->mod_shift)
+        return __guac_terminal_report_mouse(term, x, y, mask, pressed_mask, released_mask);
+
     /* Paste contents of clipboard on right or middle mouse button up */
     if ((released_mask & GUAC_CLIENT_MOUSE_RIGHT) || (released_mask & GUAC_CLIENT_MOUSE_MIDDLE))
         return guac_terminal_send_data(term, term->clipboard->buffer, term->clipboard->length);
