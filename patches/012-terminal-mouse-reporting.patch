+/**
+ * Sends one xterm mouse report to the application: button code `code`
+ * (0-2 buttons, 3 classic release, 64/65 wheel, +32 motion, +4/8/16
+ * Shift/Meta/Ctrl) at the 1-based cell col/row, as SGR when the application
+ * asked for it (`release` picks the final 'm'), else as classic X10 bytes.
+ */
+static int __guac_terminal_mouse_report(guac_terminal* term, int code,
+        int col, int row, bool release) {
+
+    char report[64];
+
+    if (term->mouse_report_sgr) {
+        snprintf(report, sizeof(report), "\x1B[<%i;%i;%i%c",
+                code, col, row, release ? 'm' : 'M');
+        return guac_terminal_send_string(term, report);
+    }
+
+    /* Classic encoding: one byte each, 32 + value, so at most 223 */
+    if (col > 223) col = 223;
+    if (row > 223) row = 223;
+    report[0] = 0x1B; report[1] = '['; report[2] = 'M';
+    report[3] = (char) (32 + (release ? 3 : code));
+    report[4] = (char) (32 + col);
+    report[5] = (char) (32 + row);
+    return guac_terminal_send_data(term, report, 6);
+
+}
+
+/**
+ * Reports mouse input to an application that enabled xterm mouse reporting
+ * (DECSET 1000/1002/1003), e.g. tmux with a pane running Claude Code: button
+ * presses and releases, the wheel (a press of button 64/65, no release), and
+ * motion as the mode asks. x and y are already without the display margin.
+ */
+static int __guac_terminal_report_mouse(guac_terminal* term, int x, int y,
+        int mask, int pressed_mask, int released_mask) {
+
+    int col = x / term->display->char_width + 1;
+    int row = y / term->display->char_height + 1;
+    if (col < 1) col = 1;
+    if (row < 1) row = 1;
+    if (col > term->term_width) col = term->term_width;
+    if (row > term->term_height) row = term->term_height;
+
+    int mods = (term->mod_shift ? 4 : 0) | ((term->mod_meta || term->mod_alt) ? 8 : 0)
+             | (term->mod_ctrl ? 16 : 0);
+
+    static const struct { int mask; int code; } buttons[] = {
+        { GUAC_CLIENT_MOUSE_LEFT,   0 },
+        { GUAC_CLIENT_MOUSE_MIDDLE, 1 },
+        { GUAC_CLIENT_MOUSE_RIGHT,  2 }
+    };
+
+    int result = 0;
+    bool reported = false;
+
+    for (int i = 0; i < 3; i++) {
+        if (pressed_mask & buttons[i].mask) {
+            result |= __guac_terminal_mouse_report(term, buttons[i].code | mods, col, row, false);
+            reported = true;
+        }
+        if (released_mask & buttons[i].mask) {
+            result |= __guac_terminal_mouse_report(term, buttons[i].code | mods, col, row, true);
+            reported = true;
+        }
+    }
+
+    /* The wheel: a press only, as xterm sends it */
+    if (pressed_mask & GUAC_CLIENT_MOUSE_SCROLL_UP) {
+        result |= __guac_terminal_mouse_report(term, 64 | mods, col, row, false);
+        reported = true;
+    }
+    if (pressed_mask & GUAC_CLIENT_MOUSE_SCROLL_DOWN) {
+        result |= __guac_terminal_mouse_report(term, 65 | mods, col, row, false);
+        reported = true;
+    }
+
+    /* Motion to another cell: with a button held (1002 or 1003), or any
+     * motion (1003) */
+    if (!reported && (col != term->mouse_report_col || row != term->mouse_report_row)) {
+        int held = -1;
+        for (int i = 0; i < 3; i++)
+            if (mask & buttons[i].mask) { held = buttons[i].code; break; }
+        if (held >= 0 && (term->mouse_report_button || term->mouse_report_any))
+            result |= __guac_terminal_mouse_report(term, 32 + held + mods, col, row, false);
+        else if (held < 0 && term->mouse_report_any)
+            result |= __guac_terminal_mouse_report(term, 32 + 3 + mods, col, row, false);
+    }
+
+    term->mouse_report_col = col;
+    term->mouse_report_row = row;
+    return result;
+
+}
