+/**
+ * The most OSC 52 data accepted, base64 included (a 4 MiB copy decodes to
+ * 3 MiB, well over the clipboard's own limit, which truncates it anyway).
+ */
+#define GUAC_TERMINAL_OSC52_MAX (4 * 1024 * 1024)
+
+int guac_terminal_clipboard_osc(guac_terminal* term, unsigned char c) {
+
+    /* OSC 52 ; <targets> ; <base64> ST: an application (tmux copy mode,
+     * Claude Code, vim, ...) setting the clipboard. The text goes to the
+     * terminal's clipboard and on to the browser, as a selection does. A
+     * query ("?") is not answered: the clipboard is not readable this way. */
+    static char* data = NULL;
+    static int length = 0;
+    static int capacity = 0;
+
+    /* Stop on ECMA-48 ST (String Terminator) */
+    if (c == 0x9C || c == 0x5C || c == 0x07) {
+
+        if (data != NULL) {
+
+            /* ST as ESC \ leaves its ESC here */
+            if (length > 0 && data[length - 1] == 0x1B)
+                length--;
+            data[length] = '\0';
+
+            /* Skip the targets ("c", "p", "s0", ... or empty) */
+            char* payload = memchr(data, ';', length);
+            if (payload != NULL && strcmp(payload + 1, "?") != 0) {
+                payload++;
+                int decoded = guac_protocol_decode_base64(payload);
+                guac_terminal_clipboard_reset(term, "text/plain");
+                guac_common_clipboard_append(term->clipboard, payload, decoded);
+                guac_common_clipboard_send(term->clipboard, term->client);
+            }
+
+            free(data);
+            data = NULL;
+        }
+
+        length = 0;
+        capacity = 0;
+        term->char_handler = guac_terminal_echo;
+        return 0;
+
+    }
+
+    /* Store everything else, growing the buffer, up to the limit */
+    if (length + 1 >= capacity) {
+        if (capacity >= GUAC_TERMINAL_OSC52_MAX)
+            return 0;
+        int grown = capacity ? capacity * 2 : 4096;
+        char* bigger = realloc(data, grown);
+        if (bigger == NULL)
+            return 0;
+        data = bigger;
+        capacity = grown;
+    }
+    data[length++] = (char) c;
+
+    return 0;
+
+}
+
